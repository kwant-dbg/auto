{
  "type": "object",
  "additionalProperties": false,
  "required": ["factors", "paths", "first10", "next_experiments", "summary"],
  "properties": {
    "factors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "low", "base", "high", "refs", "rationale"],
        "properties": {
          "code": {"type": "string", "enum": ["N_reachable", "price", "p_problem", "p_pay", "p_reach", "p_build", "retention_12m", "unit_cost", "founder_fit", "time_to_first_dollar", "defensibility_24m"]},
          "low": {"type": "number"}, "base": {"type": "number"}, "high": {"type": "number"},
          "refs": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
          "rationale": {"type": "string", "maxLength": 400}
        }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description", "channel", "weeks_to_first_dollar", "p_build"],
        "properties": {
          "path": {"type": "string", "enum": ["service_first", "narrow_software", "general_tool", "distribution_first", "acquire"]},
          "description": {"type": "string", "maxLength": 400},
          "channel": {"type": "string", "maxLength": 200},
          "weeks_to_first_dollar": {"type": "number", "minimum": 0},
          "p_build": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "first10": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_channel", "backup_channel", "prospect_sources", "founder_can_run", "notes"],
      "properties": {
        "primary_channel": {"type": "string", "maxLength": 200},
        "backup_channel": {"type": "string", "maxLength": 200},
        "prospect_sources": {"type": "array", "items": {"type": "string", "maxLength": 200}, "maxItems": 5},
        "founder_can_run": {"type": "string", "enum": ["yes", "no", "unclear"]},
        "notes": {"type": "string", "maxLength": 400}
      }
    },
    "next_experiments": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis", "method", "factors", "founder_hours", "success_threshold", "kill_threshold"],
        "properties": {
          "hypothesis": {"type": "string", "maxLength": 300},
          "method": {"type": "string", "maxLength": 300},
          "factors": {"type": "array", "items": {"type": "string"}, "maxItems": 4},
          "founder_hours": {"type": "number", "minimum": 0},
          "success_threshold": {"type": "string", "maxLength": 200},
          "kill_threshold": {"type": "string", "maxLength": 200}
        }
      }
    },
    "summary": {"type": "string", "maxLength": 600}
  }
}
