{
  "type": "object",
  "additionalProperties": false,
  "required": ["canonical_statement", "segment", "addressable", "gates", "questions", "summary"],
  "properties": {
    "canonical_statement": {"type": "string", "minLength": 10, "maxLength": 400},
    "segment": {"type": "string", "minLength": 3, "maxLength": 200},
    "addressable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {"type": "string", "enum": ["yes", "no", "unclear"]},
        "rationale": {"type": "string", "maxLength": 400}
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status", "rationale", "evidence_ids"],
        "properties": {
          "code": {"type": "string", "enum": ["F2", "F3", "F4", "M1", "M2"]},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"]},
          "rationale": {"type": "string", "maxLength": 400},
          "evidence_ids": {"type": "array", "items": {"type": "integer"}, "maxItems": 10}
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "linked_code", "kind", "p_kill", "cost_minutes"],
        "properties": {
          "text": {"type": "string", "minLength": 10, "maxLength": 400},
          "linked_code": {"type": "string", "maxLength": 20},
          "kind": {"type": "string", "enum": ["kill", "standard"]},
          "p_kill": {"type": "number", "minimum": 0, "maximum": 1},
          "cost_minutes": {"type": "integer", "minimum": 1, "maximum": 600}
        }
      }
    },
    "summary": {"type": "string", "maxLength": 800}
  }
}
